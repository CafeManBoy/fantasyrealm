# Modèle du fichier .env : copier ce fichier en .env, puis adapter les valeurs.
# Le .env contient les secrets du site : il n'est jamais commité (voir .gitignore).

# Environnement du site :
#   dev  = erreurs PHP affichées à l'écran (poste de développement)
#   prod = erreurs cachées, seulement journalisées (serveur en ligne)
# Si la valeur est absente ou différente de dev, le site se comporte comme en prod.
APP_ENV=dev

# Adresse du site, sans « / » à la fin : elle sert à écrire les liens dans les mails.
#   en local : http://fantasyrealm.test
#   en production : https://fantasyrealm5.alwaysdata.net
APP_URL=http://fantasyrealm.test

# Connexion à la base MySQL / MariaDB.
# En local (XAMPP) : 127.0.0.1, base fantasyrealm, utilisateur root sans mot de passe.
DB_HOST=127.0.0.1
DB_NAME=fantasyrealm
DB_USER=root
DB_PASSWORD=

# Connexion à MongoDB Atlas (journal des modifications des personnages).
# Adresse donnée par Atlas (Connect → Drivers), avec le mot de passe de l'utilisateur
# de l'application. L'adresse IP du poste doit être autorisée dans Atlas (Network Access).
MONGODB_URI=
